{
  "log": "vigilante.log",
  "procesarPendientesAlIniciar": "Pendiente",
  "handlers": [
    {
      "name": "ia-nueva",
      "on": "task.created",
      "when": { "status": "Pendiente" },
      "run": "node ../eventos/ia-kiro.mjs"
    },
    {
      "name": "ia-respuesta",
      "on": "task.moved",
      "when": { "to": "Pendiente" },
      "run": "node ../eventos/ia-kiro.mjs"
    }
  ]
}
